# Generate a unique random value of at least 32 characters.
PAYLOAD_SECRET=
NEXT_TELEMETRY_DISABLED=1
SITE_URL=http://localhost:3000
# Production only: domain without scheme, for Caddy automatic HTTPS.
SITE_HOST=
# Optional presentation studies. Keep false for a real public launch.
AVL_DEMO_CONTENT=false
# Local single-process development. Docker overrides this with PostgreSQL.
DATABASE_URL=file:./avl.db
DATABASE_PUSH=true
# Required only for the production Docker database.
POSTGRES_PASSWORD=
# Optional: MailerLite integration. Configure API double opt-in before enabling.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
NEWSLETTER_DOUBLE_OPT_IN_CONFIRMED=false
# Enable only behind the provided proxy, which overwrites X-Real-IP.
TRUST_PROXY=false
